APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# LLM provider: ollama or openai_compatible
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=

# Memory
DATABASE_URL=sqlite:///./jarvis.db

# Optional Home Assistant integration
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Optional MQTT integration
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Security
REQUIRE_CONFIRMATION_FOR_DEVICE_CONTROL=true
ALLOWED_TOOL_NAMES=home_assistant_service,mqtt_publish,system_status
